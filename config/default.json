{
  "app": {
    "name": "AiMate",
    "version": "1.0.0",
    "environment": "development",
    "timezone": "Asia/Seoul",
    "language": "ko-KR"
  },
  "ai": {
    "chat": {
      "provider": "vertex",
      "model": "gemini-3.5-flash",
      "prompt": "experimental",
      "temperature": null,
      "maxOutputTokens": null,
      "topP": null,
      "topK": null,
      "maxRetries": 3,
      "providerOptions": {}
    },
    "embedding": {
      "provider": "gateway",
      "model": null
    },
    "summary": {
      "provider": "gateway",
      "model": "openai/gpt-5-mini"
    },
    "image": {
      "provider": "gateway",
      "model": "openai/gpt-image-2",
      "prompt": "legacy",
      "includeTimeContext": true,
      "maxRetries": 3,
      "providerOptions": {}
    }
  },
  "discord": {
    "commandPrefix": "!",
    "botStatus": "online",
    "activityType": "PLAYING",
    "activityName": "채팅 중...",
    "fallbackStatus": "dnd"
  },
  "conversation": {
    "maxContextMessages": 20,
    "maxHistoryDays": 30,
    "enableMemory": true,
    "bufferTimeout": 5000,
    "typingDelayMin": 1000,
    "typingDelayMax": 2000,
    "typingDelayPerChar": 60
  },
  "logging": {
    "level": "info",
    "enableConsole": true,
    "enableFile": false,
    "logDirectory": "logs"
  },
  "features": {
    "enableSlashCommands": true,
    "enableTextCommands": true,
    "enableDM": true,
    "enableChannelMention": true
  },
  "secrets": {
    "discordToken": "",
    "discordClientId": "",
    "openaiApiKey": "",
    "googleApiKey": "",
    "aiGatewayApiKey": "",
    "openaiCompatibleApiKey": "",
    "vertexProjectId": "",
    "vertexLocation": "global",
    "vertexClientEmail": "",
    "vertexPrivateKey": ""
  },
  "tools": {
    "maxSteps": 5
  }
}
