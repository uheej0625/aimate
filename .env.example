# Discord Bot (config/default.yaml의 character 값에 맞춰 설정)
AIMATE_DISCORD_AI_CHAN_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
# AI_GATEWAY_API_KEY가 없을 때 사용하는 선택적 인증
VERCEL_OIDC_TOKEN=

# AI SDK OpenAI-compatible providers
OPENAI_COMPATIBLE_API_KEY=

# xAI
XAI_API_KEY=

# Google Cloud
GOOGLE_GENERATIVE_AI_API_KEY=

# Vertex AI 일반 설정 (비어 있으면 config/default.yaml의 ai.vertex 사용)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# 선택적 명시 인증. 둘 다 비우면 Google Application Default Credentials 사용
VERTEX_CLIENT_EMAIL=
VERTEX_PRIVATE_KEY=

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"
